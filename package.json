{
  "name": "qwix-webmail-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/concurrently/dist/bin/concurrently.js -k -n api,client -c cyan,magenta \"bun run dev:api\" \"bun run dev:client\"",
    "dev:api": "cd ../qwix-mailserver-api && bun run dev",
    "dev:client": "cd client && bun run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.14",
      "onFail": "download"
    }
  }
}
